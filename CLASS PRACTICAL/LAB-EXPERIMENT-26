#include <stdio.h>
int main() {
    int p[20], f[10], n, m, i, j, k, pos, far, hit, fault=0;
    printf("Enter pages: ");
    scanf("%d",&n);
    printf("Enter reference string: ");
    for(i=0;i<n;i++) scanf("%d",&p[i]);
    printf("Enter frames: ");
    scanf("%d",&m);
    for(i=0;i<m;i++) f[i]=-1;
    for(i=0;i<n;i++) {
        hit=0;
        for(j=0;j<m;j++)
            if(f[j]==p[i]) hit=1;
        if(!hit) {
            pos=0; far=-1;
            for(j=0;j<m;j++) {
                for(k=i+1;k<n;k++)
                    if(f[j]==p[k]) break;
                if(k>far) {
                    far=k;
                    pos=j;
                }
            }
            f[pos]=p[i];
            fault++;
        }
        printf("\n%d : ",p[i]);
        for(j=0;j<m;j++) printf("%d ",f[j]);
    }
    printf("\nPage Faults = %d",fault);
    printf("\nPage Hits = %d",n-fault);
    return 0;
}
