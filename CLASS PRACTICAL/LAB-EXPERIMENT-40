#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>
int main() {
    int fd;
    struct stat s;
    DIR *d;
    struct dirent *e;
    fd = open("file.txt", O_CREAT | O_RDWR, 0644);
    printf("File Descriptor: %d\n", fd);
    fcntl(fd, F_SETFL, O_APPEND);
    printf("fcntl executed\n");
    printf("File Position: %ld\n", lseek(fd, 0, SEEK_END));
    stat("file.txt", &s);
    printf("File Size: %ld bytes\n", s.st_size);
    d = opendir(".");
    printf("\nDirectory Files:\n");
    while((e = readdir(d)) != NULL)
        printf("%s\n", e->d_name);
    closedir(d);
    close(fd);
    return 0;
}
