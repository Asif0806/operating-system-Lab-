#include <stdio.h>
int main() {
    int block[20], n, i;
    printf("Enter number of blocks: ");
    scanf("%d", &n);
    printf("Enter block numbers: ");
    for(i = 0; i < n; i++)
        scanf("%d", &block[i]);
    printf("\nLinked Blocks: ");
    for(i = 0; i < n; i++) {
        printf("%d", block[i]);
        if(i < n - 1)
            printf(" -> ");
    }
    printf(" -> NULL");
    printf("\nFile allocated successfully.");
    return 0;
}
