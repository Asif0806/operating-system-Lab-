#include <stdio.h>

int main()
{
    int n, m, i, j, k;
    int alloc[5][5], max[5][5], need[5][5];
    int avail[5], finish[5] = {0}, safe[5];

    printf("Enter processes and resources: ");
    scanf("%d%d", &n, &m);

    printf("Enter Allocation Matrix:\n");
    for(i=0;i<n;i++)
        for(j=0;j<m;j++)
            scanf("%d",&alloc[i][j]);

    printf("Enter Maximum Matrix:\n");
    for(i=0;i<n;i++)
        for(j=0;j<m;j++)
            scanf("%d",&max[i][j]);

    printf("Enter Available Resources:\n");
    for(j=0;j<m;j++)
        scanf("%d",&avail[j]);

    for(i=0;i<n;i++)
        for(j=0;j<m;j++)
            need[i][j] = max[i][j] - alloc[i][j];

    k = 0;

    while(k < n)
    {
        for(i=0;i<n;i++)
        {
            if(finish[i] == 0)
            {
                for(j=0;j<m;j++)
                    if(need[i][j] > avail[j])
                        break;

                if(j == m)
                {
                    safe[k++] = i;
                    for(j=0;j<m;j++)
                        avail[j] += alloc[i][j];
                    finish[i] = 1;
                }
            }
        }

        if(k == n)
            break;

        int found = 0;
        for(i=0;i<n;i++)
            if(finish[i] == 0) found = 1;

        if(!found) break;
    }

    if(k == n)
    {
        printf("Safe State\nSafe Sequence: ");
        for(i=0;i<n;i++)
            printf("P%d ",safe[i]);
    }
    else
        printf("Unsafe State");

    return 0;
}
