#include <stdio.h>
int main() {
    int index, n, i, block[20];
    printf("Enter index block: ");
    scanf("%d", &index);
    printf("Enter number of blocks: ");
    scanf("%d", &n);
    printf("Enter allocated blocks: ");
    for(i = 0; i < n; i++)
        scanf("%d", &block[i]);
    printf("\nIndex Block = %d", index);
    printf("\nFile Blocks: ");
    for(i = 0; i < n; i++)
        printf("%d ", block[i]);
    printf("\nFile allocated successfully.");
    return 0;
}
