#include <stdio.h>

int main() {
    int disk[100], n, fileSize, method;
    int i, j, start, count;

    printf("Enter total disk blocks: ");
    scanf("%d", &n);

    printf("Enter file size (blocks): ");
    scanf("%d", &fileSize);

    printf("Enter allocation method:\n");
    printf("1. Contiguous\n");
    printf("2. Linked\n");
    printf("3. Indexed\n");
    scanf("%d", &method);

    for (i = 0; i < n; i++)
        disk[i] = 0;

    if (fileSize > n) {
        printf("Error: Not enough disk space.\n");
        return 0;
    }

    /* Contiguous Allocation */
    if (method == 1) {
        for (start = 0; start <= n - fileSize; start++) {
            count = 0;

            for (j = start; j < start + fileSize; j++) {
                if (disk[j] == 0)
                    count++;
            }

            if (count == fileSize)
                break;
        }

        if (start > n - fileSize) {
            printf("Error: Contiguous allocation failed.\n");
            printf("Continuous free space is not available.\n");
        } else {
            printf("Allocated blocks: ");
            for (i = start; i < start + fileSize; i++) {
                disk[i] = 1;
                printf("%d ", i);
            }
            printf("\n");
        }
    }
    /* Linked Allocation */
    else if (method == 2) {
        printf("Allocated blocks: ");
        count = 0;
        for (i = 0; i < n && count < fileSize; i++) {
            if (disk[i] == 0) {
                disk[i] = 1;
                printf("%d ", i);
                count++;
            }
        }

        printf("\n");
    }
    /* Indexed Allocation */
    else if (method == 3) {
        if (fileSize + 1 > n) {
            printf("Error: Not enough blocks for index and file.\n");
        } else {
            /* First free block is index block */
            for (i = 0; i < n; i++) {
                if (disk[i] == 0) {
                    disk[i] = 1;
                    printf("Index block: %d\n", i);
                    break;
                }
            }
            printf("Allocated blocks: ");

            count = 0;
            for (j = 0; j < n && count < fileSize; j++) {
                if (disk[j] == 0) {
                    disk[j] = 1;
                    printf("%d ", j);
                    count++;
                }
            }
            printf("\n");
        }
    }

    else {
        printf("Invalid allocation method.\n");
    }

    return 0;
}
