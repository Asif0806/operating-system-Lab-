#include <stdio.h>
#include <stdlib.h>
int abs(int x) { return x < 0 ? -x : x; }
int main() {
    int q[50], n, head, size, i, j, cur, seek, min, pos, temp;
    printf("Enter disk size: ");
    scanf("%d", &size);
    printf("Enter number of requests: ");
    scanf("%d", &n);
    printf("Enter request queue: ");
    for(i=0;i<n;i++) scanf("%d",&q[i]);
    printf("Enter initial head position: ");
    scanf("%d",&head);
    cur=head; seek=0;
    printf("\nFCFS: %d ",cur);
    for(i=0;i<n;i++) {
        seek += abs(cur-q[i]);
        cur=q[i];
        printf("-> %d ",cur);
    }
    printf("\nTotal Seek Time = %d\n",seek);
    int fcfs=seek;
    int done[50]={0};
    cur=head; seek=0;
    printf("\nSSTF: %d ",cur);
    for(i=0;i<n;i++) {
        min=9999;
        for(j=0;j<n;j++)
            if(!done[j] && abs(cur-q[j])<min)
                min=abs(cur-q[j]),pos=j;
        done[pos]=1;
        seek+=min;
        cur=q[pos];
        printf("-> %d ",cur);
    }
    printf("\nTotal Seek Time = %d\n",seek);
    int sstf=seek;
    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(q[i]>q[j])
                temp=q[i],q[i]=q[j],q[j]=temp;
    cur=head; seek=0;
    printf("\nSCAN: %d ",cur);
    for(i=0;i<n;i++)
        if(q[i]>=head) {
            seek+=abs(cur-q[i]);
            cur=q[i];
            printf("-> %d ",cur);
        }
    seek+=abs(cur-(size-1));
    cur=size-1;
    printf("-> %d ",cur);
    for(i=n-1;i>=0;i--)
        if(q[i]<head) {
            seek+=abs(cur-q[i]);
            cur=q[i];
            printf("-> %d ",cur);
        }
    printf("\nTotal Seek Time = %d\n",seek);
    int scan=seek;
    printf("\nBest Algorithm: ");
    if(fcfs<=sstf && fcfs<=scan) printf("FCFS");
    else if(sstf<=scan) printf("SSTF");
    else printf("SCAN");
    return 0;
}
